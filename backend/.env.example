OPENROUTER_API_KEY=
JEV_MODEL=~typesafe/jev-latest
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=JEV Command Canvas
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
FOUNDRY_PROJECT_ENDPOINT=https://foundry-agent-factory.services.ai.azure.com/api/projects/foundry-project
FOUNDRY_MODEL_DEPLOYMENT=gpt-6-luna

# Tracing (Foundry-connected Application Insights is discovered automatically)
OTEL_ENABLED=true
OTEL_SENSITIVE_DATA=true
OTEL_SERVICE_NAME=jev-command-canvas
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_CONSOLE_EXPORTERS=false

# External data providers. Holidays needs no key; the others degrade gracefully without one.
OPENXCHANGERATES_APP_ID=
OPENWEATHER_API_KEY=
DEFAULT_COUNTRY=US
# DEFAULT_SUBDIVISION=WA
DEFAULT_WEATHER_UNITS=imperial
