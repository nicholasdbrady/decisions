# Required Microsoft Foundry connection. Replace the resource and project names.
DECISION_ENDPOINT=https://your-foundry-resource.services.ai.azure.com/providers/microsoft/v1/systemone
DECISION_MODEL_DEPLOYMENT=Decision-1
DECISION_TOKEN_SCOPE=https://cognitiveservices.azure.com/.default
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
FOUNDRY_PROJECT_ENDPOINT=https://your-foundry-resource.services.ai.azure.com/api/projects/your-project
FOUNDRY_OPENAI_BASE_URL=https://your-foundry-resource.services.ai.azure.com/api/projects/your-project/openai/v1
FOUNDRY_MODEL_DEPLOYMENT=gpt-6-luna
# Optional account disambiguation for Azure CLI and cross-tenant environments.
FOUNDRY_SUBSCRIPTION_ID=
FOUNDRY_TENANT_ID=

# Tracing (Foundry-connected Application Insights is discovered automatically)
OTEL_ENABLED=true
OTEL_SENSITIVE_DATA=false
OTEL_SERVICE_NAME=jev-command-canvas
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_CONSOLE_EXPORTERS=false

# External data providers. Holidays needs no key; the others degrade gracefully without one.
OPENXCHANGERATES_APP_ID=
OPENWEATHER_API_KEY=
DEFAULT_COUNTRY=US
# DEFAULT_SUBDIVISION=WA
DEFAULT_WEATHER_UNITS=imperial
